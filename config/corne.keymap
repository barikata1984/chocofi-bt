#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };

    combos {
        compatible = "zmk,combos";

        jk2esc {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
        };

        mute {
            bindings = <&kp K_MUTE>;
            key-positions = <26 27>;
            layers = <2>;
        };
    };

    behaviors {
        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |
            //             | GUI | LWR | SPC |   | ENT | RSE | ALT |

            bindings = <
  &kp Q  &kp W  &kp E     &kp R         &kp T        &kp Y        &kp U  &kp I      &kp O    &kp P
  &kp A  &kp S  &kp D     &kp F         &kp G        &kp H        &kp J  &kp K      &kp L    &kp SEMI
  &kp Z  &kp X  &kp C     &kp V         &kp B        &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH
                &kp LGUI  &kp LEFT_ALT  &kp SPACE    &lt 2 ENTER  &mo 1  &bspc_del
            >;
        };

        lower {
            bindings = <
  &kp N1          &kp N2     &kp N3        &kp N4        &kp N5              &kp NUMBER_6       &kp N7    &kp N8     &kp N9      &kp N0
  &mt LCTRL TAB   &kp GRAVE  &trans        &trans        &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &trans    &trans     &trans      &mt RCTRL BACKSLASH
  &kp LEFT_SHIFT  &trans     &trans        &trans        &trans              &kp MINUS          &kp PLUS  &kp COMMA  &kp PERIOD  &mt RIGHT_SHIFT SLASH
                             &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE           &trans             &trans    &bspc_del
            >;
        };

        function {
            bindings = <
  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5          &kp C_AC_BACK  &kp PAGE_DOWN     &kp PG_UP     &kp C_AC_FORWARD  &kp PRINTSCREEN
  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10         &kp LEFT       &kp DOWN          &kp UP        &kp RIGHT         &kp HOME
  &kp F11  &kp F12  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3    &mkp LCLK      &kp C_VOL_DN      &kp C_VOL_UP  &mkp RCLK         &kp END
                    &kp LGUI      &kp LALT      &kp SPACE       &trans         &kp C_PLAY_PAUSE  &mkp MCLK
            >;
        };
    };
};
