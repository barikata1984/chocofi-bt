#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/gpio/gpio.h>

&mmv { time-to-max-speed-ms = <450>; };

&mt {
    flavor = "balanced";
    tapping-term-ms = <125>;
};

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };

    combos {
        compatible = "zmk,combos";

        COMBO_ENDHOME {
            bindings = <&endhome>;
            key-positions = <6 7>;
            layers = <2>;
        };

        JK2GRESC {
            bindings = <&gresc>;
            key-positions = <16 17>;
        };

        PP_PAUSE {
            bindings = <&playpause_mute>;
            key-positions = <26 27>;
            layers = <2>;
        };

        COMBO_BT_CLR {
            bindings = <&bt BT_CLR>;
            key-positions = <16 17 28>;
            layers = <2>;
        };
    };

    behaviors {
        delbspc: delbspc {
            compatible = "zmk,behavior-mod-morph";
            label = "DELBSPC";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sprleft: sprleft {
            compatible = "zmk,behavior-mod-morph";
            label = "SPRLEFT";
            bindings = <&kp LEFT_ARROW>, <&mmv MOVE_LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        sprdown: sprdown {
            compatible = "zmk,behavior-mod-morph";
            label = "SPRDOWN";
            bindings = <&kp DOWN_ARROW>, <&mmv MOVE_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        sprup: sprup {
            compatible = "zmk,behavior-mod-morph";
            label = "SPRUP";
            bindings = <&kp UP_ARROW>, <&mmv MOVE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        sprright: sprright {
            compatible = "zmk,behavior-mod-morph";
            label = "SPRRIGHT";
            bindings = <&kp RIGHT_ARROW>, <&mmv MOVE_RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        pgscrl_dn: pgscrl_dn {
            compatible = "zmk,behavior-mod-morph";
            label = "PGSCRL_DN";
            bindings = <&msc SCRL_DOWN>, <&kp PAGE_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        pgscrl_up: pgscrl_up {
            compatible = "zmk,behavior-mod-morph";
            label = "PGSCRL_UP";
            bindings = <&msc SCRL_UP>, <&kp PAGE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        endhome: endhome {
            compatible = "zmk,behavior-mod-morph";
            label = "ENDHOME";
            bindings = <&kp HOME>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_prevnext: bt_prevnext {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_PREVNEXT";
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        playpause_mute: playpause_mute {
            compatible = "zmk,behavior-mod-morph";
            label = "PLAYPAUSE_MUTE";
            bindings = <&kp K_MUTE>, <&kp K_PLAY_PAUSE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            // -----------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |
            //             | GUI | LWR | SPC |   | ENT | RSE | ALT |

            display-name = "Base";
            bindings = <
  &kp Q  &kp W  &kp E           &kp R                      &kp T          &kp Y        &kp U                &kp I          &kp O    &kp P
  &kp A  &kp S  &kp D           &kp F                      &kp G          &kp H        &kp J                &kp K          &kp L    &mt RCTRL SEMI
  &kp Z  &kp X  &kp C           &kp V                      &kp B          &kp N        &kp M                &kp COMMA      &kp DOT  &mt RIGHT_SHIFT FSLH
                &kp LEFT_SHIFT  &mt LEFT_CONTROL LEFT_GUI  &lt 1 SPACE    &lt 2 ENTER  &mt RIGHT_GUI MINUS  &kp RIGHT_ALT
            >;
        };

        Numeric {
            display-name = "Numeric";
            bindings = <
  &kp N1  &kp N2     &kp N3         &kp N4   &kp N5              &kp NUMBER_6       &kp N7     &kp N8     &kp N9            &kp N0
  &trans  &kp GRAVE  &kp BACKSLASH  &kp TAB  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp MINUS  &kp EQUAL  &kp SINGLE_QUOTE  &trans
  &trans  &trans     &trans         &trans   &trans              &trans             &trans     &trans     &trans            &trans
                     &trans         &trans   &trans              &delbspc           &trans     &trans
            >;
        };

        Functional {
            display-name = "Functional";
            bindings = <
  &kp F1   &kp F2   &kp F3        &kp F4   &kp F5          &kp C_AC_BACK  &pgscrl_dn    &pgscrl_up    &kp C_AC_FORWARD  &kp PRINTSCREEN
  &kp F6   &kp F7   &kp F8        &kp F9   &kp F10         &sprleft       &sprdown      &sprup        &sprright         &trans
  &kp F11  &kp F12  &kp F19       &kp F24  &kp CAPSLOCK    &mkp LCLK      &kp C_VOL_DN  &kp C_VOL_UP  &mkp RCLK         &trans
                    &bt_prevnext  &trans   &trans          &trans         &none         &mkp MCLK
            >;
        };
    };
};

#ifdef CONFIG_SHIELD_CORNE_RIGHT
&kscan0 {
    col-gpios
        = <&pro_micro 10 GPIO_ACTIVE_HIGH>
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>
        ;
};

&default_transform {
    col-offset = <7>;
};

&five_column_transform {
    col-offset = <7>;
};
#endif
